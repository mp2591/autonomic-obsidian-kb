{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mp2591/autonomic-obsidian-kb/schema/memory.schema.json",
  "title": "Autonomic Obsidian KB memory frontmatter v2",
  "type": "object",
  "required": ["schema_version", "id", "title", "type", "scope", "status", "summary", "confidence", "authority", "updated"],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "pattern": "^kb:[a-z0-9-]+:[a-z0-9-]+:[a-z0-9._:-]+$"},
    "title": {"type": "string", "minLength": 1},
    "kind": {"enum": ["episodic", "semantic", "procedural", "decision", "constraint", "failure", "negative", "summary", "instruction"]},
    "type": {"enum": ["agent-instruction", "api", "architecture", "command", "convention", "decision", "dependency", "domain", "environment", "fact", "file-map", "hypothesis", "interface", "invariant", "known-failure", "negative-result", "procedure", "repository-map", "solution", "terminology", "workflow"]},
    "scope": {"enum": ["global", "user", "repository", "project", "module", "branch", "task", "session"]},
    "status": {"enum": ["active", "inbox", "stale", "conflicted", "superseded", "archived", "quarantined", "retracted"]},
    "summary": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "authority": {"enum": ["source-of-truth", "authoritative", "verified", "user-corrected", "derived", "agent", "external", "untrusted"]},
    "taint": {"enum": ["trusted", "derived", "external", "agent", "untrusted", "hostile", "unknown"]},
    "authorized_instruction": {"type": "boolean"},
    "repo": {"type": "string"},
    "repository_id": {"type": "string"},
    "project": {"type": "string"},
    "module": {"type": "string"},
    "branch": {"type": "string"},
    "created": {"type": "string"},
    "updated": {"type": "string"},
    "validated": {"type": "string"},
    "freshness": {"type": "string"},
    "validity": {
      "type": "object",
      "properties": {
        "valid_from": {"type": "string"}, "valid_to": {"type": "string"},
        "as_of_commit": {"type": "string"}, "version_range": {"type": "string"}
      },
      "additionalProperties": false
    },
    "token_cost": {"type": "integer", "minimum": 0},
    "utility": {"type": "number", "minimum": 0, "maximum": 1},
    "applies_to": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "agents": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "provenance": {"type": "array", "items": {"type": "object"}},
    "evidence": {"type": "array", "items": {"type": "string", "pattern": "^evidence:sha256:[a-f0-9]{64}$"}, "uniqueItems": true},
    "validators": {"type": "array", "items": {"type": "object"}},
    "relations": {"type": "object", "additionalProperties": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]}},
    "invalidation": {"type": "object"},
    "claim_key": {"type": "string"},
    "claim_value": {}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "agent-instruction"}}, "required": ["type"]},
      "then": {"required": ["authorized_instruction", "taint"]}
    },
    {
      "if": {"properties": {"scope": {"const": "branch"}}, "required": ["scope"]},
      "then": {"required": ["branch"]}
    }
  ],
  "additionalProperties": true
}
